# Copy to .env for source development, or edit ~/.jev-assistant/.env from the app.
# Do not commit real keys. Restart Jev after changing connections.
OPENAI_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BROWSER_USE_API_KEY=
BROWSER_USE_PROFILE_ID=
BROWSER_USE_WORKSPACE_ID=
BROWSER_USE_PROXY_COUNTRY_CODE=us
BROWSER_USE_RECORD=false
BROWSER_USE_TIMEOUT_MINUTES=15
TYPESAFE_API_KEY=
ORGO_API_KEY=
JEV_COFOUNDER_COMPUTER=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=default

# Defaults; JEV_TOKEN is generated privately if omitted.
JEV_APP_PORT=3111
JEV_BRIDGE_PORT=3111
JEV_BRAIN_MODEL=gpt-6-luna
JEV_LEAD_MODEL=off
JEV_TTS=off
JEV_CLOUD_TASK_BUDGET_USD=1.00
JEV_LIVE_VOICE=marin
# JEV_MAC=off
# JEV_TALK_KEYS=off
# CUA_DRIVER=/path/to/cua-driver
